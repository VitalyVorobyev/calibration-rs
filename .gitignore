target
*.pyc
__pycache__/
.DS_Store

# Calibration image sets. Only `data/kuka_1` is committed (via LFS) and so
# only it can run in CI; the rest are large and local-only. Their `.toml`
# manifests and calibration projects are tracked.
/data/stereo/*
!/data/stereo/dataset_*.toml
!/data/stereo/left/
!/data/stereo/right/
!/data/stereo/rig/
/data/stereo/*/*
!/data/stereo/*/calibration-project.toml
/data/stereo_charuco/
/data/DS8/*
!/data/DS8/dataset.toml
!/data/DS8/calibration-project.toml
# A project's runs (and their staging folders) and its detection cache are
# local results, never committed.
/data/**/runs/
/data/**/.detections/

# Private dataset registry: paths and gates for datasets that are not ours
# to publish. The *baselines* derived from them are committed, deliberately
# — they hold reprojection statistics only.
/crates/vision-calibration-bench/registry/private.json

# Lockfiles. The workspace root's is tracked, and so is the `apps/studio`
# workspace's (the app is a binary, and binaries pin their dep tree). The rule below
# exists for `crates/vision-calibration-examples-private/`, which is its own
# workspace and whose lockfile we do not carry.
Cargo.lock
!/Cargo.lock
!/apps/studio/Cargo.lock

# Scratch output from the review skills.
REVIEW.md

# Local working notes; never committed.
docs/internal/

# codegraph daemon runtime state (machine-local)
.codegraph/daemon.pid
.codegraph/codegraph.lock
