# Keep in sync with .prettierignore / .oxlintrc.json ignorePatterns.
node_modules
src-tauri/target
src-tauri/gen
tsconfig.tsbuildinfo
# `dist/` is regenerated by `bun run build`. We commit a placeholder
# `index.html` so `cargo check` for the Tauri backend succeeds before
# `bun install` has ever run; the placeholder is the only thing that
# survives a checkout.
dist/*
!dist/.gitkeep
!dist/index.html
# Playwright smoke-test artifacts (B-QUAL4).
playwright-report
test-results
# The screenshot suite's local baseline (playwright.screens.config.ts).
e2e/.screens
# Run-workspace presets for datasets outside the repository.
src/workspaces/RunWorkspace/presets.local.ts
# Sample runs for the browser viewer (run.rs `write_viewer_sample_runs`).
.tmp-runs
