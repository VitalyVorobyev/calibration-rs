{
  "name": "calibration-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test -c playwright.smoke.config.ts",
    "lint": "oxlint --max-warnings 0",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "generate:api:schema": "cargo run -q -p studio-core --bin studio-schema",
    "generate:api:schema:check": "cargo run -q -p studio-core --bin studio-schema -- --check",
    "generate:api:ts": "bun scripts/generate-api.mjs && prettier --write src/api/generated",
    "generate:api": "bun run generate:api:schema && bun run generate:api:ts",
    "test:screens": "playwright test -c playwright.screens.config.ts",
    "serve": "bun scripts/serve.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@vitavision/charts": "^0.8.4",
    "@vitavision/forms": "^0.8.4",
    "@vitavision/overlays": "0.4.0",
    "@vitavision/stage2d": "0.16.0",
    "@vitavision/three": "^0.2.2",
    "@vitavision/three-react": "^0.2.2",
    "@vitavision/ui": "^0.14.2",
    "@vitavision/workbench": "0.3.4",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "three": "0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.5",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "@vitavision/config-oxlint": "^0.1.0",
    "@vitavision/config-ts": "^0.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "31.0.1",
    "json-schema-to-typescript": "^16.0.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "packageManager": "bun@1.4.2"
}
