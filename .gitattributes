# Check text files out with LF on every platform, overriding Git for Windows'
# default `core.autocrlf=true`. Generated files — `app/src/schemas/*.json` from
# `cargo xtask emit-schemas`, checked byte-for-byte by CI — are written with LF
# by the generator, so a CRLF checkout makes every one of them look like drift.
# The binary rules below still win for their patterns (last match wins).
* text=auto eol=lf

*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.bmp filter=lfs diff=lfs merge=lfs -text
# Build-critical tiny assets stay as normal git blobs — CI checkouts do not
# fetch LFS, and tauri::generate_context! must read a real PNG at compile time.
app/src-tauri/icons/*.png -filter -diff -merge -text
