*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.bmp filter=lfs diff=lfs merge=lfs -text
# Build-critical tiny assets stay as normal git blobs — CI checkouts do not
# fetch LFS, and tauri::generate_context! must read a real PNG at compile time.
app/src-tauri/icons/*.png -filter -diff -merge -text
