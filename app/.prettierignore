# Keep in sync with app/.gitignore / eslint.config.js ignores.
dist
node_modules
src-tauri/target
src-tauri/gen
tsconfig.tsbuildinfo
bun.lock
playwright-report
test-results

# Rust-emitted JSON Schemas: byte-for-byte owned by their emitters and
# drift-checked against them, so prettier must not reformat them.
#   - schemas-generated/  <- app/src-tauri `emit_schemas` (diagnose wire types)
#   - src/schemas/        <- `cargo xtask emit-schemas` (user-facing configs)
# The generated *.ts under src/types/generated IS formatted (the
# generate:types script runs prettier over it) and stays checked.
schemas-generated
src/schemas

# Prettier's markdown formatter mis-reformats blockquote continuation
# lines that contain a code span split across the wrap (observed
# corrupting README.md's Tauri-context callout) — out of scope for this
# lint/format pass, which targets the TS/TSX + config-file surface.
*.md
