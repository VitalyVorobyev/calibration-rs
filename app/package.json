{
  "name": "calibration-diagnose",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "generate:schemas": "cargo run --manifest-path src-tauri/Cargo.toml --features schema-export --bin emit_schemas",
    "generate:schemas:check": "cargo run --manifest-path src-tauri/Cargo.toml --features schema-export --bin emit_schemas -- --check",
    "generate:types:ts": "bun scripts/generate-types.mjs && prettier --write src/types/generated",
    "generate:types": "bun run generate:schemas && bun run generate:types:ts",
    "test:screens": "playwright test -c playwright.screens.config.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@vitavision/forms": "^0.7.0",
    "@vitavision/stage2d": "^0.10.0",
    "@vitavision/three": "^0.1.0",
    "@vitavision/three-react": "^0.1.0",
    "@vitavision/ui": "^0.11.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "three": "0.186.1",
    "toml": "5.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitavision/config-eslint": "^0.1.0",
    "@vitavision/config-ts": "^0.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "30.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "bun@1.4.2"
}
