{
  "name": "calibration-diagnose",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "generate:schemas": "cargo run --manifest-path src-tauri/Cargo.toml --features schema-export --bin emit_schemas",
    "generate:schemas:check": "cargo run --manifest-path src-tauri/Cargo.toml --features schema-export --bin emit_schemas -- --check",
    "generate:types:ts": "bun scripts/generate-types.mjs && prettier --write src/types/generated",
    "generate:types": "bun run generate:schemas && bun run generate:types:ts",
    "test:screens": "playwright test -c playwright.screens.config.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@vitavision/charts": "^0.8.3",
    "@vitavision/forms": "^0.8.3",
    "@vitavision/stage2d": "^0.13.2",
    "@vitavision/three": "^0.2.0",
    "@vitavision/three-react": "^0.2.0",
    "@vitavision/ui": "^0.14.0",
    "@vitavision/workbench": "^0.3.2",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "three": "0.186.1",
    "toml": "5.0.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitavision/config-eslint": "^0.1.1",
    "@vitavision/config-ts": "^0.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "30.1.2",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.4.2"
}
