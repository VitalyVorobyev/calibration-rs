{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "calibration-diagnose",
  "version": "0.1.0",
  "mainBinaryName": "calibration-diagnose",
  "identifier": "com.vitalyvorobyev.calibration-diagnose",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": ".."
    },
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": ".."
    }
  },
  "app": {
    "windows": [
      {
        "title": "calibration-rs · diagnose",
        "label": "main",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
